{
  "name": "magni",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "description": "Magni - React Native (Expo) app with web support",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@mui/material": "^7.3.6",
    "@mui/x-date-pickers": "^8.22.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.2",
    "date-fns": "^4.1.0",
    "expo": "~58.0.26",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-date-picker": "^12.0.1",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-uuid": "^2.0.3",
    "react-native-web": "^0.21.4",
    "victory": "^37.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^9.39.5",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.14.0",
    "husky": "^9.0.11",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-native-async-storage|react-native-uuid|victory|@testing-library|@babel|expo|expo-modules-core|expo-router|expo-status-bar|react-native-gesture-handler|react-native-safe-area-context|react-native-screens|react-native-svg|react-native-vector-icons|react-native-web|@mui|@emotion|date-fns)/)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js",
      "<rootDir>/jest.setup.rntl.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.(test|spec).(js|jsx|ts|tsx)"
    ],
    "collectCoverageFrom": [
      "lib/**/*.{js,jsx,ts,tsx}",
      "hooks/**/*.{js,jsx,ts,tsx}",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "<rootDir>/node_modules/@react-native-async-storage/async-storage"
    }
  }
}
