# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DATABASE_URL=postgres://user:replace-with-url-encoded-password@postgres:5432/modi?sslmode=disable

# Redis Configuration
REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379/0
REDIS_PASSWORD=replace-with-a-long-random-password

# Database container credentials. Use long random values; passwords included in
# connection URLs must be URL encoded.
POSTGRES_DB=modi
POSTGRES_USER=modi
POSTGRES_PASSWORD=replace-with-a-long-random-password

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h

# Comma-separated browser origins permitted to call the API. Use your HTTPS
# Cloudflare Tunnel hostnames in production; never use * with credentials.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Only set this when requests pass through a trusted proxy/tunnel that provides
# client IP headers. Comma-separated CIDRs, for example 172.20.0.0/16.
TRUSTED_PROXY_CIDRS=
AUTH_RATE_LIMIT_PER_MINUTE=10

# Logging
LOG_LEVEL=info
